# --- App ---
APP_NAME=RadIntel AI
DEBUG=true
FRONTEND_ORIGIN=http://localhost:3000

# --- Auth ---
# Generate a real secret with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-to-a-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- MongoDB ---
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=radintel

# --- ChromaDB ---
CHROMA_PERSIST_DIR=./chroma_data
CHROMA_COLLECTION=pneumonia_knowledge

# --- File storage ---
UPLOAD_DIR=./uploads

# --- Model ---
# Set to "false" once you have a real trained model at MODEL_PATH
USE_MOCK_MODEL=true
MODEL_PATH=./ml_models/efficientnet_b0_pneumonia.pt

# --- LLM provider (for report generation + chat) ---
ANTHROPIC_API_KEY=your_key_here
LLM_MODEL=claude-sonnet-4-6
